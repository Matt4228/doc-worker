DATABASE_URL=postgresql://user:password@localhost:5432/docworker
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional, defaults to claude-haiku-5-5
ANTHROPIC_MODEL=claude-haiku-5-5

# Comma-separated frontend origins allowed by CORS. Defaults to the local
# dev server; set to the Vercel URL in production.
ALLOWED_ORIGINS=http://localhost:3000

# Required: every /documents and /chat request must send this as a Bearer
# token, and the API refuses all requests if it's unset. Use a long random
# passphrase for any deployed copy.
DEMO_PASSWORD=change-me
